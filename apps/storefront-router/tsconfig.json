{
  "include": [
    "app/components/**/*",
    "app/legacy/**/*",
    "app/lib/**/*",
    "app/shims/**/*",
    "app/styles/**/*",
    "app/types/**/*",
    "src/**/*",
    "vite.config.ts"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"],
      "@lib/*": ["./app/legacy/lib/*"],
      "@modules/*": ["./app/legacy/modules/*"],
      "styles/*": ["./app/styles/*"],
      "types/*": ["./app/legacy/types/*"]
    }
  }
}
