STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# Cashfree Payments
# Sandbox keys start with TEST / cfsk_ma_test_; production keys do not. The
# provider refuses to boot if the key does not match the mode.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Defaults to sandbox unless NODE_ENV=production. Set explicitly to override.
CASHFREE_MODE=sandbox
# Optional: pin a different Cashfree API version.
CASHFREE_API_VERSION=
# Optional: where Cashfree posts webhooks, if not set in their dashboard.
# Must be publicly reachable: https://<backend>/hooks/payment/cashfree_cashfree
CASHFREE_NOTIFY_URL=
